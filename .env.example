# Copy this file to .env and fill in the values. Never commit .env.

# Finnhub
FINNHUB_API_KEY=

# Kafka (used by producer.py / consumer.py on your PC)
KAFKA_BOOTSTRAP=localhost:29092
KAFKA_TOPIC=stock-quotes

# MinIO
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=
MINIO_ENDPOINT=http://minio:9000           # used by Airflow (inside Docker)
MINIO_ENDPOINT_LOCAL=http://localhost:9000 # used by consumer.py (on your PC)
MINIO_BUCKET=bronzestock

# Snowflake
SNOWFLAKE_ACCOUNT=
SNOWFLAKE_USER=
SNOWFLAKE_PASSWORD=
SNOWFLAKE_WAREHOUSE=
SNOWFLAKE_DB=
SNOWFLAKE_SCHEMA=

# Airflow
AIRFLOW_DB_USER=
AIRFLOW_DB_PASSWORD=
AIRFLOW_DB_NAME=
AIRFLOW_SECRET_KEY=
AIRFLOW_ADMIN_USER=
AIRFLOW_ADMIN_PASSWORD=
